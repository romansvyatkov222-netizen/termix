# Frontend build output (rebuilt by `npm run build`, embedded into the exe)
dist/

# Frontend dependencies (restored by `npm ci`)
node_modules/

# Rust build output (rebuilt by cargo / tauri)
src-tauri/target/

# Tauri codegen output (regenerated by tauri-build on every build)
src-tauri/gen/

# Vite / editor caches
.vite/
*.log
.DS_Store
Thumbs.db

# Local IDE state (keep shared configs like .vscode/settings.json if any)
.idea/
*.code-workspace

# Agent working notes (per-repo, not part of the project)
AGENTS.md
