{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termix",
  "version": "0.1.5",
  "identifier": "app.termix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Termix",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/termix.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxREMyMjU5QjM0NjA2Q0UKUldUT0JrYXpXU0xjVWFsMFIwRXJ4d3JGajJ0WENsem1idnVwUlYzMWdZOFlhRDc0aW8zZ3FCSlYK",
      "endpoints": [
        "https://github.com/romansvyatkov222-netizen/termix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
